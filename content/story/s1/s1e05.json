  "scenes": [
    {
      "bg": "hall",
      "cg": null,
      "cast": [
        "sodam",
        "muyeong"
      ],
      "lines": [
        {
          "who": "npc:윤서경",
          "text": "청원은 받았습니다. 사본만으로 창고를 몰수할 수는 없습니다."
        },
        {
          "who": "me",
          "text": "몰수 전에 안을 보자는 겁니다. 자물쇠가 꽤 말이 없어서요."
        },
        {
          "who": "sodam",
          "text": "지급 기록과 수령 확인이 열두 자루만큼 다릅니다."
        },
        {
          "who": "npc:윤서경",
          "text": "재고 확인 명령은 내리겠습니다. 입회자는 양쪽에서 세우죠."
        },
        {
          "who": "muyeong",
          "text": "흑운채 몫으로 적힌 물건도 확인하겠소."
        },
        {
          "who": "npc:윤서경",
          "text": "당신도 조사 대상입니다. 그 점을 받아들입니까?"
        },
        {
          "who": "muyeong",
          "text": "내 이름이 있으면 내 답도 있어야 하오."
        },
        {
          "who": "me",
          "text": "좋습니다. 제 품삯도 빼놓지 마시고요."
        },
        {
          "who": "npc:윤서경",
          "text": "왕실 몫의 세금도 확인합니다. 청원인만을 위한 조사는 아닙니다."
        },
        {
          "who": "me",
          "text": "서로 볼 장부가 같으면 시작은 되겠지요."
        }
      ]
    },
    {
      "bg": "market",
      "cg": null,
      "cast": [
        "baekseol",
        "sodam",
        "muyeong"
      ],
      "lines": [
        {
          "who": "narration",
          "text": "관리인이 열쇠를 잃었다고 하자 조사관이 자물쇠 개방을 허가했다."
        },
        {
          "who": "me",
          "text": "방망이 임자도 열쇠 수리공부터 시작하는군."
        },
        {
          "who": "baekseol",
          "text": "멈추세요. 손잡이가 엽전 주머니 쪽으로 기울어요."
        },
        {
          "who": "sodam",
          "text": "비용 상한을 정하겠습니다. 스무 닢을 넘어가면 중단하세요."
        },
        {
          "who": "narration",
          "text": "열 닢이 잿빛으로 바스러졌다. 문이 열리자 다리가 휘청했다."
        },
        {
          "who": "muyeong",
          "text": "기력도 드는군. 임자, 내 팔을 잡으시오."
        },
        {
          "who": "me",
          "text": "돈만 먹는 줄 알았는데 점심까지 요구하네."
        },
        {
          "who": "sodam",
          "text": "빈 칸 바닥에 젖은 갈대가 있습니다. 수레 운송 기록과 다릅니다."
        },
        {
          "who": "baekseol",
          "text": "강으로 나갔겠네요. 증거는 손대기 전에 그려 두죠."
        },
        {
          "who": "narration",
          "text": "조사관이 갈대를 봉인했다. 방망이의 금은 손톱 길이만큼 늘었다."
        }
      ],
