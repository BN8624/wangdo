  "scenes": [
    {
      "bg": "market",
      "cg": null,
      "cast": [
        "baekseol",
        "sodam"
      ],
      "lines": [
        {
          "who": "npc:송채령",
          "text": "품삯과 밀린 배급을 지급하겠습니다. 사본을 모두 돌려주시죠."
        },
        {
          "who": "me",
          "text": "원래 줄 돈에 새 조건이 붙으면 이자라도 받아야겠는데요."
        },
        {
          "who": "npc:송채령",
          "text": "분쟁을 오래 끌면 당장 먹을 사람이 손해입니다."
        },
        {
          "who": "sodam",
          "text": "지급은 받겠습니다. 사본 반환에는 동의하지 않습니다."
        },
        {
          "who": "npc:송채령",
          "text": "백설 씨도 같은 생각인가요? 계약 기한이 얼마 남지 않았는데."
        },
        {
          "who": "baekseol",
          "text": "제 기한으로 다른 분의 밥값을 흥정하지 마세요."
        },
        {
          "who": "me",
          "text": "어떤 계약이오?"
        },
        {
          "who": "npc:송채령",
          "text": "당사자에게 들으세요. 저는 강제로 데려가러 온 것이 아닙니다."
        },
        {
          "who": "narration",
          "text": "채령은 지급 봉투를 놓고 갔다. 백설의 손가락이 거울 테두리를 눌렀다."
        },
        {
          "who": "sodam",
          "text": "지급 내역부터 확인하겠습니다. 대화는 천천히 하세요."
        }
      ]
    },
    {
      "bg": "night",
      "cg": null,
      "cast": [
        "baekseol"
      ],
      "lines": [
        {
          "who": "baekseol",
          "text": "예전에 동족의 빚을 막으려고 제 이름을 담보로 걸었어요."
        },
        {
          "who": "me",
          "text": "기한이 지나면 어떻게 되오?"
        },
        {
          "who": "baekseol",
          "text": "계약 안에서는 거절할 이름이 없어져요. 불러도 제 뜻이 아니죠."
        },
        {
          "who": "me",
          "text": "방망이로 계약을 부술 수는 없겠소?"
        },
        {
          "who": "baekseol",
          "text": "부수면 보증 선 동족에게 빚이 넘어가요. 그건 싫어요."
        },
        {
          "who": "me",
          "text": "그럼 장부를 밝혀서 잘못 붙은 빚부터 덜어 냅시다."
        },
        {
          "who": "baekseol",
          "text": "제 사정이 나리의 출세에 짐이 될 수도 있어요."
        },
        {
          "who": "me",
          "text": "나무꾼 지게도 빈 채로는 품삯을 못 받소. 같이 계산해 봅시다."
        },
        {
          "who": "baekseol",
          "text": "가벼운 말인데 이상하게 믿고 싶네요, 나리."
        },
        {
          "who": "narration",
          "text": "백설이 내 손을 잠깐 잡았다 놓았다. 방망이는 아무 반응도 없었다."
        }
      ],
