  "scenes": [
    {
      "bg": "night",
      "cg": null,
      "cast": [
        "baekseol",
        "sodam"
      ],
      "lines": [
        {
          "who": "npc:송채령",
          "text": "별창 열쇠입니다. 조사관과 함께 가세요."
        },
        {
          "who": "me",
          "text": "이번에는 사본 반환이 값입니까?"
        },
        {
          "who": "npc:송채령",
          "text": "원본의 출처를 숨기지 마세요. 제가 제출했다고 기록하십시오."
        },
        {
          "who": "baekseol",
          "text": "가문과 선을 그으시려고요?"
        },
        {
          "who": "npc:송채령",
          "text": "가문을 물려받으려면 썩는 곳부터 알아야 합니다."
        },
        {
          "who": "sodam",
          "text": "장부를 고친 적은 없습니까? 제출 경위도 확인하겠습니다."
        },
        {
          "who": "npc:송채령",
          "text": "제 담당란은 제 책임입니다. 다만 아버지 지시는 빈칸일 겁니다."
        },
        {
          "who": "me",
          "text": "빈칸도 보여야 어디부터 물을지 알겠지요."
        },
        {
          "who": "npc:송채령",
          "text": "백설 씨의 담보는 별도입니다. 이 장부만으로 끝나지 않아요."
        },
        {
          "who": "baekseol",
          "text": "알아요. 그래도 오늘 밝힐 것까지 미룰 이유는 없죠."
        }
      ]
    },
    {
      "bg": "hall",
      "cg": null,
      "cast": [
        "sodam",
        "muyeong",
        "baekseol"
      ],
      "lines": [
        {
          "who": "narration",
          "text": "조사관 입회 아래 가져온 원본은 소담의 사본과 날짜가 일치했다."
        },
        {
          "who": "sodam",
          "text": "같은 곡식을 달골에는 지급, 흑운채에는 대여로 적었습니다."
        },
        {
          "who": "muyeong",
          "text": "우리에게 받은 무기까지 운송료로 다시 청구했군."
        },
        {
          "who": "npc:윤서경",
          "text": "대리인의 인장도 맞습니다. 다만 상급 승인란은 뜯겼습니다."
        },
        {
          "who": "me",
          "text": "송 대감을 곧장 부를 수는 없다는 말이군요."
        },
        {
          "who": "npc:윤서경",
          "text": "의심과 입증은 다릅니다. 우선 창고를 보전해야 합니다."
        },
        {
          "who": "baekseol",
          "text": "나리, 드디어 열쇠를 합법적으로 가지시겠네요."
        },
        {
          "who": "npc:윤서경",
          "text": "임시 창고 감독을 맡으세요. 인출에는 공동 서명이 필요합니다."
        },
        {
          "who": "me",
          "text": "열쇠보다 감시자가 더 많군요. 그 조건으로 맡겠습니다."
        },
        {
          "who": "sodam",
          "text": "첫 업무는 재고 확인입니다. 축하 술은 그다음이에요."
        }
      ],
