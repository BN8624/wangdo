 "scenes":[
  {"level":1,"title":"첫 손님","lines":[{"who":"narration","text":"달골 장터 한쪽에 새 좌판이 펼쳐졌다."},{"who":"her","text":"어서 오세요. 구경은 마음껏 하셔도 된답니다."},{"who":"me","text":"방울이가 연 가게야?"},{"who":"her","text":"그렇지요. 오늘의 첫 손님이시랍니다."},{"who":"narration","text":"방울이 하나뿐인 꼬리로 값표를 가지런히 폈다."},{"who":"me","text":"인사가 참 반갑네."},{"who":"her","text":"그 말은 첫 매상보다 기쁜데요."},{"who":"narration","text":"방울의 꼬리 끝이 살짝 위로 솟았다."}]},
  {"level":2,"title":"장부의 빈칸","lines":[{"who":"narration","text":"방울이 장부 구석에 작은 꽃을 그렸다."},{"who":"me","text":"꽃도 장부에 적어?"},{"who":"her","text":"기분 좋은 일이 생기면 그리는 표시랍니다."},{"who":"me","text":"오늘은 꽃이 많네."},{"who":"her","text":"할머니가 단골이 되셨고, 아이가 인사했지요."},{"who":"narration","text":"방울이 내 쪽을 보고 꽃 한 송이를 더했다."},{"who":"me","text":"나는 뭘 샀더라?"},{"who":"her","text":"와 주신 것만으로도 적을 만하답니다."}]},
  {"level":3,"title":"꼬리의 그림자","lines":[{"who":"narration","text":"개울가에 방울의 길고 가느다란 그림자가 비쳤다."},{"who":"her","text":"그림자도 꼬리는 하나뿐이네요."},{"who":"me","text":"마음에 걸려?"},{"who":"her","text":"구미호라면 아홉이어야 한다고들 하지요."},{"who":"her","text":"꼬리가 적어서 제 말을 안 믿을까 걱정이랍니다."},{"who":"narration","text":"방울이 꼬리 끝을 치마 뒤로 슬쩍 감췄다."},{"who":"me","text":"네 장사를 보여 주자."},{"who":"her","text":"제 곁에서 지켜봐 주실 건가요?"}]},
  {"level":4,"title":"믿음의 값표","lines":[{"who":"narration","text":"나는 방울과 좌판의 물건 수를 함께 확인했다."},{"who":"me","text":"값표가 잘 보이네."},{"who":"her","text":"모두에게 같은 값을 받기로 했답니다."},{"who":"narration","text":"거스름을 받은 손님이 고개를 끄덕였다."},{"who":"her","text":"다음 장날에도 오시겠대요."},{"who":"me","text":"네 정직함을 본 거야."},{"who":"her","text":"오늘은 꼬리를 감추지 않아도 되겠답니다."},{"who":"narration","text":"방울의 꼬리가 좌판 옆에서 당당히 흔들렸다."}]},
  {"level":5,"title":"기한 없는 약속","lines":[{"who":"narration","text":"축제 밤, 방울이 좌판 옆에 의자를 하나 더 놓았다."},{"who":"her","text":"이 자리는 늘 비워 두려 한답니다."},{"who":"me","text":"내 자리야?"},{"who":"her","text":"네. 꼬리가 아홉이 되어도 함께 앉아 주세요."},{"who":"narration","text":"방울이 매듭 끈 한쪽을 내 손에 올렸다."},{"who":"me","text":"오래 함께 앉을게."},{"who":"her","text":"저도 곁에 있겠답니다. 기한은 없지요."},{"who":"narration","text":"등불 아래 매듭 두 끝이 나란히 흔들렸다."}]}
